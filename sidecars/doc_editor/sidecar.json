{
  "name": "doc_editor",
  "display_name": "Antigravity Document Editor",
  "description": "Interactive visual document editor and viewer for Microsoft Word (.docx) and OpenDocument Text (.odt)",
  "command": "powershell",
  "args": [
    "-NoProfile",
    "-ExecutionPolicy",
    "Bypass",
    "-File",
    "server.ps1"
  ],
  "has_web_ui": true,
  "restart_policy": "always",
  "ui_config": {
    "display_name": "Antigravity Document Editor",
    "views": [
      {
        "title": "Document Editor",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "path": "/ui.html"
      }
    ]
  }
}
